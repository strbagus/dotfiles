{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/strbagus/.config/fastfetch/images/ascii-art.txt",
    "padding": {
      "left": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "title",
    "break",
    {
      "type": "host",
      "key": "󰌢",
      "keyColor": "green",
      "format": "{}"
    },
    {
      "type": "cpu",
      "key": "󰻠",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "󰍹",
      "keyColor": "green",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰑭",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "󰋊",
      "keyColor": "green"
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "󰌽",
      "keyColor": "yellow"
    },
    {
      "type": "bios",
      "key": "󰖡",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "󰏗",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "󰞷",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "de",
      "key": "󰧨",
      "keyColor": "blue"
    },
    {
      "type": "lm",
      "key": "󰍁",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "󱂬",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "󰉦",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "󰆍",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "command",
      "key": "›  OS Age  ",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "›  Uptime  ",
      "keyColor": "magenta"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
